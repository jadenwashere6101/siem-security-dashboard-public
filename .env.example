SIEM_DB_PASSWORD=your-value-here

# Legacy generic DB aliases supported for compatibility
DB_NAME=your-value-here
DB_USER=your-value-here
DB_HOST=your-value-here
DB_PASSWORD=your-value-here

# SIEM ingest authentication
SIEM_INGEST_API_KEY=your-value-here
INGEST_API_KEY=your-value-here

# SIEM runtime options
