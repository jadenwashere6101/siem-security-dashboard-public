[Unit]
Description=Anakin Async Workflow Worker (bounded read-only)
After=network-online.target postgresql.service siem-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=jaden
Group=jaden
WorkingDirectory=/home/jaden/siem-security-dashboard
EnvironmentFile=/home/jaden/siem-security-dashboard/.env
Environment=PYTHONUNBUFFERED=1
Environment=ANAKIN_WORKFLOW_BATCH_SIZE=3
Environment=ANAKIN_WORKFLOW_STALE_RECOVERY_LIMIT=25
Environment=ANAKIN_WORKFLOW_MAX_RUNTIME_SECONDS=240
Environment=ANAKIN_WORKFLOW_LEASE_DURATION_SECONDS=240
# Read-only AI workflow execution only: no preview/confirm, SOAR actions, repo assistant, or SOC briefing generation.
ExecStart=/home/jaden/siem-security-dashboard/scripts/run_anakin_workflow_worker_service.sh --json
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
